+        voiceEngine.speak("Buscando en Wikipedia, por internet.")
         viewModelScope.launch {
             val result = runCatching { wikipediaLookup.search(query) }.getOrNull()
-            if (result == null) {
+            if (result != null && SensitiveTopics.isBlocked(query, result.title)) {
+                voiceEngine.speak(SensitiveTopics.BLOCKED_REPLY, listenAfter = true)
+            } else if (result == null) {
                 voiceEngine.speak("No encontré nada en Wikipedia sobre eso.")
             } else {
                 pendingWikiRest = result.rest
                 voiceEngine.speak(
-                    result.short + if (result.rest != null) " Si quieres saber más, di dime más." else "",
+                    "Según Wikipedia: " + result.short + if (result.rest != null) " Si quieres saber más, di dime más." else "",
                     listenAfter = true,
                 )
             }
@@ -391,7 +405,8 @@ class DashboardViewModel @Inject constructor(
         // Matched against VoiceText.fold(text) — accents stripped, same length as the original — so the
         // captured group's range lines up with the words the person actually said, accents and all.
         val WIKI_TRIGGER = Regex(
-            "(?:busca(?:r)? en wikipedia|busca(?:r)?|informacion sobre|dime sobre|" +
+            // Only at the start of the phrase: "no sé qué es lo que me pasa" is not a question for an encyclopedia.
+            "^\s*(?:busca(?:r)? en wikipedia|busca(?:r)?|informacion sobre|dime sobre|" +
                 "que es|quien es|quien fue|wikipedia)\\s+(.+)",
         )
     }
