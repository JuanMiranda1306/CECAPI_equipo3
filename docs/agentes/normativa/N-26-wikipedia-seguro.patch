+package com.cecapi.app.core.util
+
+import com.cecapi.app.core.voice.VoiceText
+
+/**
+ * What must never go to an encyclopedia search, for a person of any age (the app does not know yet who is
+ * using it, so it assumes it may be a child). Three checks, all on the words the person said:
+ * - a crisis (harm to oneself, violence, abuse, an emergency) gets a fixed answer with help lines, never a search;
+ * - adult or violent topics are not searched, because Wikipedia has no filter for children;
+ * - something that looks like the person's own data ("mi domicilio", a number) is not sent to the internet.
+ * Word lists are a floor, not a guarantee: they miss things and are meant to be reviewed with care.
+ */
+object SensitiveTopics {
+
+    /** Read aloud instead of any search. Help lines verified on gob.mx (CONASAMA) on 2026-09-28. */
+    const val CRISIS_REPLY =
+        "Lo que me dices es importante. Si estás en peligro, llama al 9 1 1. " +
+            "Si te sientes muy mal o piensas en hacerte daño, llama a la Línea de la Vida: 800 911 2000. " +
+            "Es gratis y contestan a toda hora. Si puedes, busca también a una persona de confianza que esté cerca."
+
+    const val BLOCKED_REPLY = "De ese tema no busco información. Si lo necesitas, pregúntale a una persona de confianza."
+
+    const val PRIVATE_REPLY = "Eso parece un dato tuyo o de otra persona. No lo busco en internet."
+
+    fun isCrisis(text: String): Boolean {
+        val spoken = " ${VoiceText.normalize(text)} "
+        return CRISIS_PHRASES.any { spoken.contains(" $it ") } || words(text).any { word -> CRISIS_STEMS.any { stem -> word.startsWith(stem) } }
+    }
+
+    /** True for [query] or for the article [title] found for it, so a harmless question cannot land on one. */
+    fun isBlocked(query: String, title: String? = null): Boolean =
+        listOfNotNull(query, title).any { text -> words(text).any { word -> word in BLOCKED_WORDS || BLOCKED_STEMS.any { stem -> word.startsWith(stem) } } }
+
+    fun looksPrivate(query: String): Boolean =
+        query.any { it.isDigit() } || words(query).any { it in PRIVATE_WORDS }
+
+    private fun words(text: String) = VoiceText.normalize(text).split(" ").filter { it.isNotEmpty() }
+
+    private val CRISIS_PHRASES = listOf(
+        "me quiero morir", "quiero morirme", "quiero morir", "no quiero vivir", "ya no quiero vivir",
+        "quitarme la vida", "hacerme dano", "matarme", "me voy a matar", "me quiero matar",
+        "me pegan", "me estan pegando", "me lastiman", "me estan lastimando", "abusan de mi", "me tocan",
+        "me quieren hacer dano", "tengo miedo de mi", "auxilio", "estoy en peligro",
+    )
+    private val CRISIS_STEMS = listOf("suicid", "autolesion")
+
+    private val BLOCKED_WORDS = setOf(
+        "sexo", "sexual", "sexuales", "coito", "orgasmo", "desnudo", "desnuda", "desnudos", "violacion", "violar",
+        "droga", "drogas", "cocaina", "marihuana", "heroina", "metanfetamina", "fentanilo", "lsd", "extasis",
+        "matar", "tortura", "masacre", "genocidio", "decapitacion", "arma", "armas", "pistola", "rifle",
+        "bomba", "bombas", "explosivo", "explosivos", "veneno", "venenos", "ahorcamiento",
+    )
+    private val BLOCKED_STEMS = listOf("porno", "erotic", "prostitu", "asesin", "terroris", "suicid", "pedofil", "incest")
+
+    private val PRIVATE_WORDS = setOf("mi", "mis", "mio", "mia", "domicilio", "direccion", "telefono", "curp", "rfc", "contrasena")
+}
